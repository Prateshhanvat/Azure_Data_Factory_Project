{
	"name": "CopyDataFromRESTAPI",
	"properties": {
		"activities": [
			{
				"name": "Copy data from REST API",
				"type": "Copy",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "RestSource",
						"httpRequestTimeout": "00:01:40",
						"requestInterval": "00.00:00:00.010",
						"requestMethod": "GET",
						"paginationRules": {
							"supportRFC5988": "true"
						}
					},
					"sink": {
						"type": "JsonSink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings"
						},
						"formatSettings": {
							"type": "JsonWriteSettings"
						}
					},
					"enableStaging": false,
					"translator": {
						"type": "TabularTranslator",
						"mappings": [
							{
								"source": {
									"path": "$['organic_results'][0]['position']"
								},
								"sink": {
									"name": "position",
									"type": "Int16"
								}
							},
							{
								"source": {
									"path": "$['organic_results'][0]['title']"
								},
								"sink": {
									"name": "title",
									"type": "String"
								}
							},
							{
								"source": {
									"path": "$['organic_results'][0]['link']"
								},
								"sink": {
									"name": "link",
									"type": "String"
								}
							},
							{
								"source": {
									"path": "$['organic_results'][0]['source']"
								},
								"sink": {
									"name": "source",
									"type": "String"
								}
							},
							{
								"source": {
									"path": "$['organic_results'][0]['date']"
								},
								"sink": {
									"name": "date",
									"type": "String"
								}
							},
							{
								"source": {
									"path": "$['organic_results'][0]['iso_date']"
								},
								"sink": {
									"name": "iso_date",
									"type": "DateTime"
								}
							},
							{
								"source": {
									"path": "$['organic_results'][0]['snippet']"
								},
								"sink": {
									"name": "snippet",
									"type": "String"
								}
							},
							{
								"source": {
									"path": "$['organic_results'][0]['favicon']"
								},
								"sink": {
									"name": "favicon",
									"type": "String"
								}
							},
							{
								"source": {
									"path": "$['organic_results'][0]['thumbnail']"
								},
								"sink": {
									"name": "thumbnail",
									"type": "String"
								}
							}
						],
						"collectionReference": "$['organic_results']"
					}
				},
				"inputs": [
					{
						"referenceName": "DS_REST_API",
						"type": "DatasetReference"
					}
				],
				"outputs": [
					{
						"referenceName": "DS_Storage",
						"type": "DatasetReference"
					}
				]
			}
		],
		"annotations": [],
		"lastPublishTime": "2026-08-02T09:09:31Z"
	},
	"type": "Microsoft.DataFactory/factories/pipelines"
}